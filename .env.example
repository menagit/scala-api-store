# Database (MySQL 8.4 in Docker). Copy this file to .env and fill in the secrets.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=api_store
MYSQL_USER=api_store
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
# DB_POOL_SIZE=10

# Mail. In development these point to Mailpit, which needs no login.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@apistore.local
# Front-end address used in email links
FRONTEND_BASE_URL=http://localhost:3000

# JWT access token signing key , at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL=15 minutes
# JWT_REFRESH_TOKEN_TTL=30 days

# Key that encrypts secrets stored in the database (AES-256): 32 random bytes in Base64.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# GraphQL query limits
# GRAPHQL_MAX_DEPTH=15
# GRAPHQL_MAX_COMPLEXITY=300

# CORS: comma-separated origins allowed to call the API from a browser (e.g. http://localhost:8000). Empty means none.
CORS_ALLOWED_ORIGINS=

# Product images: folder for the files and the public base URL of GET /images (no trailing slash)
# IMAGES_STORAGE_DIR=
# IMAGES_BASE_URL=

# Play application secret. Only needed in production. Generate with: openssl rand -base64 48
# PLAY_HTTP_SECRET_KEY=

